+        // Discard recorded work without submitting it. The caller establishes completion before resetting.
+        void DiscardCommands(CommandBufferMTL* c)
+        {
+            if (c->renderEnc)
+            {
+                [c->renderEnc endEncoding];
+                [c->renderEnc release];
+                c->renderEnc = nil;
+            }
+            EndAux(c);
+            if (c->cmd)
+            {
+                [c->cmd release];
+                c->cmd = nil;
+            }
+            c->boundLayout            = nullptr;
+            c->boundPipeline          = nullptr;
+            c->renderPipelineDeferred = false;
+            c->indexBuffer            = nil;
+            c->indexOffset            = 0;
+            c->indexType              = MTLIndexTypeUInt16;
+            for (auto& binding : c->computeBuffers)
+            {
+                binding.kind        = CommandBufferMTL::ComputeBufferBinding::Kind::Empty;
+                binding.descriptor  = nullptr;
+                binding.argumentSet = nullptr;
+                binding.bytes.clear();
+            }
+            std::fill(c->computeTextures.begin(), c->computeTextures.end(), nullptr);
+            std::fill(c->computeSamplers.begin(), c->computeSamplers.end(), nullptr);
+            c->visNextSlot = 0;
+            c->occMarks.clear();
+            c->tsResolves.clear();
+        }
+
+        void VRI_CALL ResetCommandAllocator(VriCommandAllocator* allocator)
+        {
+            for (auto* commands : CA(allocator)->commands)
+            {
+                DiscardCommands(commands);
+            }
+        }
+
+        void VRI_CALL DestroyCommandAllocator(VriCommandAllocator* allocator)
+        {
+            auto* a = CA(allocator);
+            for (auto* commands : a->commands)
+            {
+                DiscardCommands(commands);
+                [commands->visBuffer release];
+                [commands->tsScratch release];
+                delete commands;
+            }
+            delete a;
+        }
 
