         void VRI_CALL CmdBarrier(VriCommandBuffer*, const VriBarrierGroupDesc*) {} // Ordinary tracked-resource hazards.
 
+        VriResult VRI_CALL CmdBufferBarrierRange(VriCommandBuffer* cmd, const VriBufferBarrierDesc* barrier)
+        {
+            if (!cmd || !barrier || !barrier->buffer)
+                return VriResult_InvalidArgument;
+            CommandBufferMTL* c = CB(cmd);
+            BufferMTL* buffer = Buf(barrier->buffer);
+            if (!c->cmd || c->renderEnc || buffer->device != c->device || !buffer->buffer ||
+                barrier->offset >= buffer->size || barrier->size > buffer->size - barrier->offset)
+                return VriResult_InvalidArgument;
+            // Tracked Metal resources need no explicit access-state transition; hazards may cover the whole buffer.
+            return c->recordingResult;
+        }
