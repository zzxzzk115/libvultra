+                copy.srcSubresource.layerCount != copy.dstSubresource.layerCount)
+            {
+                command->recordingResult = VriResult_InvalidArgument;
+                return;
+            }
+            if (source->samples != VK_SAMPLE_COUNT_1_BIT || destination->samples != VK_SAMPLE_COUNT_1_BIT)
+            {
+                command->recordingResult = VriResult_Unsupported;
+                return;
+            }
+            uint32_t pixelBytes = 4;
+            if (copy.srcSubresource.aspectMask == VK_IMAGE_ASPECT_STENCIL_BIT)
+            {
