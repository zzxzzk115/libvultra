         // A private encoder preserves user bindings; the existing kernels write selected native mips/layers.
+        VriResult VRI_CALL CmdClearDepthStencilTextureRange(VriCommandBuffer* cmd, VriTexture* texture,
+                                                            const VriClearDepthStencil* value,
+                                                            const VriTextureSubresourceRange* selected,
+                                                            VriImageAspectFlags aspects)
+        {
+            if (!cmd || !texture || !value)
+                return VriResult_InvalidArgument;
+            auto* c = CB(cmd);
+            const auto* t = Tex(texture);
+            const auto required = VriTextureUsage_DepthStencilAttachment | VriTextureUsage_TransferDst;
+            if (!c->cmd || c->renderEnc || t->device != c->device || !t->texture || (t->usage & required) != required ||
+                !([t->texture usage] & MTLTextureUsageRenderTarget))
+                return VriResult_InvalidArgument;
+            VriImageAspectFlags available = VriImageAspect_None;
+            switch (t->format)
+            {
+                case VriFormat_D16_UNORM:
+                case VriFormat_D32_SFLOAT: available = VriImageAspect_Depth; break;
+                case VriFormat_S8_UINT: available = VriImageAspect_Stencil; break;
+                case VriFormat_D24_UNORM_S8_UINT:
+                case VriFormat_D32_SFLOAT_S8_UINT: available = VriImageAspect_Depth | VriImageAspect_Stencil; break;
+                default: return VriResult_InvalidArgument;
+            }
+            aspects = aspects ? aspects : available;
+            auto range = selected ? *selected : VriTextureSubresourceRange {};
+            if ((aspects & ~available) || range.baseMip >= t->mipNum || range.baseLayer >= t->layerNum ||
+                ((aspects & VriImageAspect_Depth) && (!std::isfinite(value->depth) || value->depth < 0 || value->depth > 1)) ||
+                ((aspects & VriImageAspect_Stencil) && value->stencil > 255))
+                return VriResult_InvalidArgument;
+            range.mipNum = range.mipNum ? range.mipNum : t->mipNum - range.baseMip;
+            range.layerNum = range.layerNum ? range.layerNum : t->layerNum - range.baseLayer;
+            if (range.mipNum > t->mipNum - range.baseMip || range.layerNum > t->layerNum - range.baseLayer)
+                return VriResult_InvalidArgument;
+            if (t->type != VriTextureType_2D && t->type != VriTextureType_2DArray &&
+                t->type != VriTextureType_Cube && t->type != VriTextureType_CubeArray)
+                return VriResult_Unsupported;
+            if (c->recordingResult != VriResult_Success)
+                return c->recordingResult;
+            EndAux(c);
+            @autoreleasepool
+            {
+                for (uint32_t mip = range.baseMip; mip < range.baseMip + range.mipNum; ++mip)
+                {
+                    for (uint32_t layer = range.baseLayer; layer < range.baseLayer + range.layerNum; ++layer)
+                    {
+                        MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+                        if (aspects & VriImageAspect_Depth)
+                        {
+                            pass.depthAttachment.texture = t->texture;
+                            pass.depthAttachment.level = mip;
+                            pass.depthAttachment.slice = layer;
+                            pass.depthAttachment.loadAction = MTLLoadActionClear;
+                            pass.depthAttachment.storeAction = MTLStoreActionStore;
+                            pass.depthAttachment.clearDepth = value->depth;
+                        }
+                        if (aspects & VriImageAspect_Stencil)
+                        {
+                            pass.stencilAttachment.texture = t->texture;
+                            pass.stencilAttachment.level = mip;
+                            pass.stencilAttachment.slice = layer;
+                            pass.stencilAttachment.loadAction = MTLLoadActionClear;
+                            pass.stencilAttachment.storeAction = MTLStoreActionStore;
+                            pass.stencilAttachment.clearStencil = value->stencil;
+                        }
+                        // A private encoder leaves user pipeline/descriptor caches available for the next pass.
+                        id<MTLRenderCommandEncoder> encoder = [c->cmd renderCommandEncoderWithDescriptor:pass];
+                        if (!encoder)
+                        {
+                            c->recordingResult = VriResult_Failure;
+                            return c->recordingResult;
+                        }
+                        [encoder setLabel:@"VRI.ClearDepthStencilTextureRange"];
+                        [encoder endEncoding];
+                    }
+                }
+            }
+            return VriResult_Success;
+        }
