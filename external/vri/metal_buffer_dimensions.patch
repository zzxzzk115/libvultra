+    // SPIRV-Cross lowers OpArrayLength to byte sizes. Inline bytes are copied by Metal, so
+    // later descriptor binds cannot change an earlier dispatch's metadata.
+    void BindBufferSizes(CommandBufferMTL* c)
+    {
+        const PipelineMTL* p = c->boundPipeline;
+        if (!p) return;
+        // Validate the currently bound set after pipeline switches as well as initial binds.
+        // SPIRV-Cross uses uint byte sizes, so a queried view larger than UINT32_MAX bytes cannot be represented.
+        for (const auto& range : p->bufferSizeArgumentRanges)
+        {
+            const DescriptorSetMTL* set = range.set < c->bufferSizeArgumentSets.size() ?
+                c->bufferSizeArgumentSets[range.set] : nullptr;
+            if (!set || range.first > set->entries.size() || range.count > set->entries.size() - range.first)
+            {
+                c->device->ReportError("buffer-size metadata requires a matching bound argument set");
+                c->recordingResult = VriResult_InvalidArgument;
+                return;
+            }
+            for (uint32_t i = 0; i < range.count; ++i)
+                if (set->entries[range.first + i].bufferSize > UINT32_MAX)
+                {
+                    c->device->ReportError("buffer view exceeds Metal's 32-bit buffer-size metadata");
+                    c->recordingResult = VriResult_Unsupported;
+                    return;
+                }
+        }
+        if (c->renderEnc)
+        {
+            const uint32_t restore = p->vertexBufferMask & c->vertexSizeBindings;
+            for (uint32_t index = 0; index < kMaxMtlBuffers; ++index)
+                if (restore & (1u << index))
+                {
+                    const auto& vertex = c->vertexBuffers[index];
+                    [c->renderEnc setVertexBuffer:vertex.buffer offset:vertex.offset atIndex:index];
+                    c->vertexSizeBindings &= ~(1u << index);
+                }
+        }
+        for (uint32_t stage = 0; stage < p->bufferSizeMasks.size(); ++stage)
+        {
+            const uint32_t mask = p->bufferSizeMasks[stage];
+            if (!mask || (stage == 0) != p->isCompute) continue;
+            std::array<uint32_t, kMaxMtlBuffers> sizes{};
+            for (uint32_t index = 0; index < kMaxMtlBuffers; ++index)
+            {
+                const uint64_t value = c->bufferSizes[stage][index];
+                if ((mask & (1u << index)) && value > UINT32_MAX)
+                {
+                    c->device->ReportError("buffer view exceeds Metal's 32-bit buffer-size metadata");
+                    c->recordingResult = VriResult_Unsupported;
+                    return;
+                }
+                sizes[index] = uint32_t(value);
+            }
+            const uint32_t index = p->bufferSizeIndices[stage];
+            switch (kBufferSizeStages[stage])
+            {
+                case VriShaderStage_Compute:
+                    [c->computeEnc setBytes:sizes.data() length:sizeof(sizes) atIndex:index];
+                    break;
+                case VriShaderStage_Vertex:
+                    [c->renderEnc setVertexBytes:sizes.data() length:sizeof(sizes) atIndex:index];
+                    c->vertexSizeBindings |= 1u << index;
+                    break;
+                case VriShaderStage_Fragment:
+                    [c->renderEnc setFragmentBytes:sizes.data() length:sizeof(sizes) atIndex:index];
+                    break;
+                case VriShaderStage_Mesh:
+                    [c->renderEnc setMeshBytes:sizes.data() length:sizeof(sizes) atIndex:index];
+                    break;
+                case VriShaderStage_Task:
+                    [c->renderEnc setObjectBytes:sizes.data() length:sizeof(sizes) atIndex:index];
+                    break;
+                default: break;
+            }
+        }
+    }
+
