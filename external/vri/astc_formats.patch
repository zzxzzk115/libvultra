+    // Metal buffer/texture copies measure compressed rows in blocks, including tail mips.
+    inline CopyBlockLayout TextureCopyBlock(VriFormat f)
+    {
+        switch (f)
+        {
+            case VriFormat_BC1_UNORM: case VriFormat_BC1_SRGB: case VriFormat_BC4_UNORM:
+                return {4, 4, 8};
+            case VriFormat_BC2_UNORM: case VriFormat_BC2_SRGB:
+            case VriFormat_BC3_UNORM: case VriFormat_BC3_SRGB: case VriFormat_BC5_UNORM:
+            case VriFormat_BC6H_UFLOAT: case VriFormat_BC7_UNORM: case VriFormat_BC7_SRGB:
+            case VriFormat_ASTC_4X4_UNORM: case VriFormat_ASTC_4X4_SRGB:
+                return {4, 4, 16};
+            case VriFormat_ASTC_6X6_UNORM: case VriFormat_ASTC_6X6_SRGB:
+                return {6, 6, 16};
+            default:
+                return {1, 1, 0}; // Caller uses TexelSize for uncompressed formats.
+        }
+    }
+
