+#pragma once
+
+#include "core_vk.h"
+#include "conversions_vk.h"
+
+#include <array>
+
+namespace vri::vk
+{
+    // The list lives through the native create/query call, including any existing external-memory pNext chain.
+    struct TextureViewFormatListVK
+    {
+        std::array<VkFormat, VriFormat_Count> formats {};
+        VkImageFormatListCreateInfo list {VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO};
+
+        VriResult Configure(const VriDevice* device, const VriTextureDesc& desc, VkImageCreateInfo& image)
+        {
+            if (!(desc.usage & VriTextureUsage_MutableFormat)) return VriResult_Success;
+            if (!GetTextureViewFormatSupport(device, desc.format, desc.format, desc.usage))
+                return VriResult_Unsupported;
+            for (int candidate = int(VriFormat_Unknown) + 1; candidate < int(VriFormat_Count); ++candidate)
+            {
+                const auto view = VriFormat(candidate);
+                if (GetTextureViewFormatSupport(device, desc.format, view, desc.usage))
+                    formats[list.viewFormatCount++] = ToVkFormat(view);
+            }
+            image.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+            list.pNext = image.pNext;
+            list.pViewFormats = formats.data();
+            image.pNext = &list;
+            return VriResult_Success;
+        }
+    };
+} // namespace vri::vk
