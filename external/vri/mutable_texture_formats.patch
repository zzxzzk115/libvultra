+        if (format >= VriFormat_RG8_UNORM && format <= VriFormat_RG8_SINT) return 0x0802;
+        if (format >= VriFormat_RGBA8_UNORM && format <= VriFormat_BGRA8_SRGB) return 0x0804;
+        if (format >= VriFormat_R16_UNORM && format <= VriFormat_R16_SFLOAT) return 0x1001;
+        if (format >= VriFormat_RG16_UNORM && format <= VriFormat_RG16_SFLOAT) return 0x1002;
+        if (format >= VriFormat_RGBA16_UNORM && format <= VriFormat_RGBA16_SFLOAT) return 0x1004;
+        if (format >= VriFormat_R32_UINT && format <= VriFormat_R32_SFLOAT) return 0x2001;
+        if (format >= VriFormat_RG32_UINT && format <= VriFormat_RG32_SFLOAT) return 0x2002;
+        if (format >= VriFormat_RGB32_UINT && format <= VriFormat_RGB32_SFLOAT) return 0x2003;
