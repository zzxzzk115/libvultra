+        // Restore a released build-scratch allocation without replacing the object's name or identity.
+        void Grow(const void* handle, uint64_t bytes, uint32_t newHeight)
+        {
+            const std::lock_guard<std::mutex> lock {m_mutex};
+            const auto                        it = m_objects.find(handle);
+            if (it == m_objects.end())
