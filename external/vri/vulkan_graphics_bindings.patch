         // ---- views & samplers ----------------------------------------------
         VriResult VRI_CALL CreateBufferView(VriDevice* device, const VriBufferViewDesc* desc, VriDescriptor** out)
         {
+            if (!device || !desc || !out || !desc->buffer)
+                return VriResult_InvalidArgument;
+            *out = nullptr;
+            const BufferVK* buffer = Buf(desc->buffer);
+            if (buffer->device != Dev(device) || !buffer->buffer || desc->offset >= buffer->size ||
+                desc->size > buffer->size - desc->offset)
+                return VriResult_InvalidArgument;
             DescriptorVK* v = new DescriptorVK {};
             v->kind         = DescriptorVK::Kind::BufferView;
             v->device       = Dev(device);
             v->buffer       = Buf(desc->buffer);
             v->bufferOffset = desc->offset;
-            v->bufferRange  = desc->size;
+            v->bufferRange  = desc->size ? desc->size : buffer->size - desc->offset;
             *out            = ToHandle(v);
             return VriResult_Success;
         }
