+#ifndef VRI_EXT_COLOR_INPUT_H
+#define VRI_EXT_COLOR_INPUT_H
+
+#include "../vri_pipeline.h"
+#include "../vri_resource.h"
+
+VRI_EXTERN_C_BEGIN
+
+#define VRI_INTERFACE_COLOR_INPUT "VriColorInputInterface"
+
+typedef struct VriColorInputPass VriColorInputPass;
+typedef struct VriColorInputTarget VriColorInputTarget;
+
+typedef struct VriColorInputPassDesc
+{
+    VriFormat input;
+    VriFormat output;
+    VriFormat depth; /* Unknown disables depth. Single-sampled, depth-only formats. */
+} VriColorInputPassDesc;
+
+typedef enum VriColorInputPhase
+{
+    VriColorInputPhase_Raster = 0,
+    VriColorInputPhase_Resolve = 1
+} VriColorInputPhase;
+
+/* Two framebuffer-local phases. Raster clears and writes input and optional depth.
+ * Resolve reads input attachment index 0 and writes output. Input contents are discarded
+ * at the end. Output and depth are stored. The caller transitions the images to their
+ * color/depth attachment layouts before recording and owns their later transitions.
+ *
+ * Destroy targets before their pass and views. Destroy all objects only after GPU use ends.
+ * The pipeline must match the phase. Enter, advance and end on the same graphics command buffer.
+ */
+typedef struct VriColorInputInterface
+{
+    VriResult (VRI_CALL *CreatePass)(VriDevice*, const VriColorInputPassDesc*, VriColorInputPass**);
+    void (VRI_CALL *DestroyPass)(VriColorInputPass*);
+    VriResult (VRI_CALL *CreateTarget)(VriColorInputPass*, const VriDescriptor* input,
+                                      const VriDescriptor* output, const VriDescriptor* depth,
+                                      VriColorInputTarget**);
+    void (VRI_CALL *DestroyTarget)(VriColorInputTarget*);
+    VriResult (VRI_CALL *CreatePipeline)(VriColorInputPass*, VriColorInputPhase,
+                                        const VriGraphicsPipelineDesc*, VriPipeline**);
+    VriResult (VRI_CALL *CmdBegin)(VriCommandBuffer*, const VriColorInputTarget*,
+                                  const VriClearValue* inputClear, float depthClear);
+    VriResult (VRI_CALL *CmdResolve)(VriCommandBuffer*);
+    VriResult (VRI_CALL *CmdEnd)(VriCommandBuffer*);
+} VriColorInputInterface;
+
+VRI_EXTERN_C_END
+
+#endif /* VRI_EXT_COLOR_INPUT_H */
