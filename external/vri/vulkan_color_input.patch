@@ -0,0 +1,205 @@
+        struct ColorInputPassVK
+        {
+            DeviceVK* device;
+            VkRenderPass pass;
+            VriColorInputPassDesc formats;
+        };
+
+        struct ColorInputTargetVK
+        {
+            ColorInputPassVK* pass;
+            VkFramebuffer framebuffer;
+            VkExtent2D extent;
+        };
+
+        VriResult VRI_CALL CreateColorInputPass(VriDevice* device, const VriColorInputPassDesc* desc,
+                                               VriColorInputPass** out)
+        {
+            if (!out)
+                return VriResult_InvalidArgument;
+            *out = nullptr;
+            if (!device || !desc)
+                return VriResult_InvalidArgument;
+            const bool depth = desc->depth != VriFormat_Unknown;
+            const auto input = ToVkFormat(desc->input);
+            const auto output = ToVkFormat(desc->output);
+            const auto depthFormat = ToVkFormat(desc->depth);
+            if (input == VK_FORMAT_UNDEFINED || output == VK_FORMAT_UNDEFINED ||
+                (depth && desc->depth != VriFormat_D16_UNORM && desc->depth != VriFormat_D32_SFLOAT))
+                return VriResult_InvalidArgument;
+            auto* d = Dev(device);
+            for (auto format : {input, output})
+            {
+                VkFormatProperties properties {};
+                vkGetPhysicalDeviceFormatProperties(d->PhysicalDevice(), format, &properties);
+                if (!(properties.optimalTilingFeatures & VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT))
+                    return VriResult_Unsupported;
+            }
+
+            const VkAttachmentDescription attachments[] = {
+                {0, input, VK_SAMPLE_COUNT_1_BIT, VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_DONT_CARE,
+                 VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_DONT_CARE,
+                 VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL},
+                {0, output, VK_SAMPLE_COUNT_1_BIT, VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
+                 VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_DONT_CARE,
+                 VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL},
+                {0, depthFormat, VK_SAMPLE_COUNT_1_BIT, VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_STORE,
+                 VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_DONT_CARE,
+                 VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL}};
+            const VkAttachmentReference inputWrite {0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+            const VkAttachmentReference inputRead {0, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+            const VkAttachmentReference outputWrite {1, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+            const VkAttachmentReference depthWrite {2, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL};
+            const uint32_t preserveDepth = 2;
+            VkSubpassDescription phases[2] {};
+            phases[0].pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+            phases[0].colorAttachmentCount = 1;
+            phases[0].pColorAttachments = &inputWrite;
+            phases[0].pDepthStencilAttachment = depth ? &depthWrite : nullptr;
+            phases[1].pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+            phases[1].inputAttachmentCount = 1;
+            phases[1].pInputAttachments = &inputRead;
+            phases[1].colorAttachmentCount = 1;
+            phases[1].pColorAttachments = &outputWrite;
+            phases[1].preserveAttachmentCount = depth ? 1u : 0u;
+            phases[1].pPreserveAttachments = depth ? &preserveDepth : nullptr;
+
+            // The input is also subject to the final attachment store operation, even
+            // with DONT_CARE. Order that write after the subpass layout transition.
+            const VkSubpassDependency dependency {
+                0, 1, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                VK_ACCESS_INPUT_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                VK_DEPENDENCY_BY_REGION_BIT};
+            const VkRenderPassCreateInfo create {
+                VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO, nullptr, 0, depth ? 3u : 2u, attachments,
+                2, phases, 1, &dependency};
+            VkRenderPass pass = VK_NULL_HANDLE;
+            if (vkCreateRenderPass(d->Device(), &create, nullptr, &pass) != VK_SUCCESS)
+                return VriResult_Failure;
+            *out = reinterpret_cast<VriColorInputPass*>(new ColorInputPassVK {d, pass, *desc});
+            return VriResult_Success;
+        }
+
+        void VRI_CALL DestroyColorInputPass(VriColorInputPass* handle)
+        {
+            auto* pass = reinterpret_cast<ColorInputPassVK*>(handle);
+            vkDestroyRenderPass(pass->device->Device(), pass->pass, nullptr);
+            delete pass;
+        }
+
+        VriResult VRI_CALL CreateColorInputTarget(VriColorInputPass* handle, const VriDescriptor* input,
+                                                 const VriDescriptor* output, const VriDescriptor* depth,
+                                                 VriColorInputTarget** out)
+        {
+            if (!out)
+                return VriResult_InvalidArgument;
+            *out = nullptr;
+            if (!handle)
+                return VriResult_InvalidArgument;
+            auto* pass = reinterpret_cast<ColorInputPassVK*>(handle);
+            const bool hasDepth = pass->formats.depth != VriFormat_Unknown;
+            if (hasDepth != (depth != nullptr))
+                return VriResult_InvalidArgument;
+            const auto valid = [&](const VriDescriptor* handle, VriFormat format, VkImageAspectFlags aspect,
+                                   VriTextureUsageFlags usage) {
+                const auto* view = Desc(handle);
+                return view && view->kind == DescriptorVK::Kind::TextureView && view->device == pass->device &&
+                       view->format == ToVkFormat(format) && view->aspect == aspect && view->attachmentExtent.width &&
+                       view->attachmentExtent.height && view->texture->singleSampleAttachment &&
+                       (view->texture->usage & usage) == usage;
+            };
+            if (!valid(input, pass->formats.input, VK_IMAGE_ASPECT_COLOR_BIT,
+                       VriTextureUsage_ColorAttachment | VriTextureUsage_InputAttachment) ||
+                !valid(output, pass->formats.output, VK_IMAGE_ASPECT_COLOR_BIT, VriTextureUsage_ColorAttachment) ||
+                (depth && !valid(depth, pass->formats.depth, VK_IMAGE_ASPECT_DEPTH_BIT,
+                                 VriTextureUsage_DepthStencilAttachment)))
+                return VriResult_InvalidArgument;
+
+            const auto extent = Desc(input)->attachmentExtent;
+            const auto sameExtent = [&](const VriDescriptor* handle) {
+                const auto other = Desc(handle)->attachmentExtent;
+                return extent.width == other.width && extent.height == other.height;
+            };
+            if (Desc(input)->texture == Desc(output)->texture || !sameExtent(output) ||
+                (depth && !sameExtent(depth)))
+                return VriResult_InvalidArgument;
+            const VkImageView views[] {Desc(input)->imageView, Desc(output)->imageView,
+                                      depth ? Desc(depth)->imageView : VK_NULL_HANDLE};
+            const VkFramebufferCreateInfo create {
+                VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO, nullptr, 0, pass->pass, depth ? 3u : 2u, views,
+                extent.width, extent.height, 1};
+            VkFramebuffer framebuffer = VK_NULL_HANDLE;
+            if (vkCreateFramebuffer(pass->device->Device(), &create, nullptr, &framebuffer) != VK_SUCCESS)
+                return VriResult_Failure;
+            *out = reinterpret_cast<VriColorInputTarget*>(new ColorInputTargetVK {pass, framebuffer, extent});
+            return VriResult_Success;
+        }
+
+        void VRI_CALL DestroyColorInputTarget(VriColorInputTarget* handle)
+        {
+            auto* target = reinterpret_cast<ColorInputTargetVK*>(handle);
+            vkDestroyFramebuffer(target->pass->device->Device(), target->framebuffer, nullptr);
+            delete target;
+        }
+
+        VriResult VRI_CALL CreateColorInputPipeline(VriColorInputPass* handle, VriColorInputPhase phase,
+                                                   const VriGraphicsPipelineDesc* desc, VriPipeline** out)
+        {
+            if (!out)
+                return VriResult_InvalidArgument;
+            *out = nullptr;
+            if (!handle || !desc || (phase != VriColorInputPhase_Raster && phase != VriColorInputPhase_Resolve))
+                return VriResult_InvalidArgument;
+            const auto* pass = reinterpret_cast<const ColorInputPassVK*>(handle);
+            const auto& merger = desc->outputMerger;
+            const bool raster = phase == VriColorInputPhase_Raster;
+            if (merger.viewMask || merger.colorNum != 1 || !merger.colors || desc->multisample.sampleNum != 1 ||
+                merger.colors[0].format != (raster ? pass->formats.input : pass->formats.output) ||
+                merger.depthStencilFormat != (raster ? pass->formats.depth : VriFormat_Unknown))
+                return VriResult_InvalidArgument;
+            return CreateGraphicsPipelineVK(reinterpret_cast<VriDevice*>(pass->device), desc, out, pass->pass, phase);
+        }
+
+        VriResult VRI_CALL CmdBeginColorInput(VriCommandBuffer* cmd, const VriColorInputTarget* handle,
+                                             const VriClearValue* inputClear, float depthClear)
+        {
+            if (!cmd || !handle || !inputClear)
+                return VriResult_InvalidArgument;
+            auto* commands = CB(cmd);
+            const auto* target = reinterpret_cast<const ColorInputTargetVK*>(handle);
+            if (commands->device != target->pass->device || commands->colorInputPhase)
+                return VriResult_InvalidArgument;
+            VkClearValue clear[3] {};
+            std::memcpy(&clear[0].color, &inputClear->color, sizeof(clear[0].color));
+            clear[2].depthStencil.depth = depthClear;
+            const VkRenderPassBeginInfo begin {
+                VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO, nullptr, target->pass->pass, target->framebuffer,
+                {{0, 0}, target->extent}, target->pass->formats.depth == VriFormat_Unknown ? 1u : 3u, clear};
+            vkCmdBeginRenderPass(commands->cmd, &begin, VK_SUBPASS_CONTENTS_INLINE);
+            commands->colorInputPhase = 1;
+            return VriResult_Success;
+        }
+
+        VriResult VRI_CALL CmdResolveColorInput(VriCommandBuffer* cmd)
+        {
+            if (!cmd || CB(cmd)->colorInputPhase != 1)
+                return VriResult_InvalidArgument;
+            vkCmdNextSubpass(CB(cmd)->cmd, VK_SUBPASS_CONTENTS_INLINE);
+            CB(cmd)->colorInputPhase = 2;
+            return VriResult_Success;
+        }
+
+        VriResult VRI_CALL CmdEndColorInput(VriCommandBuffer* cmd)
+        {
+            if (!cmd || CB(cmd)->colorInputPhase != 2)
+                return VriResult_InvalidArgument;
+            vkCmdEndRenderPass(CB(cmd)->cmd);
+            CB(cmd)->colorInputPhase = 0;
+            return VriResult_Success;
+        }
+
+        const VriColorInputInterface g_colorInputVK {
+            CreateColorInputPass, DestroyColorInputPass, CreateColorInputTarget, DestroyColorInputTarget,
+            CreateColorInputPipeline, CmdBeginColorInput, CmdResolveColorInput, CmdEndColorInput};
