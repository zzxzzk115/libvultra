+        void* VRI_CALL GetQueueNativeHandle(const VriQueue* queue)
+        {
+            return queue ? reinterpret_cast<const QueueMTL*>(queue)->queue : nullptr;
+        }
+
+        void* VRI_CALL GetTextureNativeHandle(const VriTexture* texture)
+        {
+            return texture ? reinterpret_cast<const TextureMTL*>(texture)->texture : nullptr;
+        }
+
+        void* VRI_CALL GetBufferNativeHandle(const VriBuffer* buffer)
+        {
+            return buffer ? reinterpret_cast<const BufferMTL*>(buffer)->buffer : nullptr;
