+        VriResult VRI_CALL WrapTexture(VriDevice* device, const VriWrapTextureDesc* desc, VriTexture** out)
+        {
+            if (!device || !desc || !desc->nativeTexture || !out) return VriResult_InvalidArgument;
+            DeviceMTL* d = Dev(device);
+            id<MTLTexture> native = static_cast<id<MTLTexture>>(desc->nativeTexture);
+            const auto& requested = desc->desc;
+            if (native.device != d->Device() || native.pixelFormat != ToMtlFormat(requested.format) ||
+                native.width != requested.width || native.height != requested.height ||
+                requested.type != VriTextureType_2D || requested.layerNum != 1 || requested.mipNum != 1 ||
+                requested.sampleNum != 1 || native.textureType != MTLTextureType2D)
+                return VriResult_InvalidArgument;
+            auto* t = new TextureMTL {};
+            t->device = d;
+            t->texture = native;
+            t->format = requested.format;
+            t->mtlFormat = native.pixelFormat;
+            t->type = requested.type;
+            t->width = requested.width;
+            t->height = requested.height;
+            t->depth = 1;
+            t->mipNum = 1;
+            t->layerNum = 1;
+            t->sampleNum = 1;
+            t->texelSize = TexelSize(requested.format);
+            t->owned = false;
+            *out = ToHandle(t);
+            return VriResult_Success;
         }
 
