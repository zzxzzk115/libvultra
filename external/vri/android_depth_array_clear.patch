+            VkClearAttachment depthArrayClear {};
+#if defined(__ANDROID__)
+            // Qualcomm load clears can overwrite earlier depth-array slices in the same command buffer.
+            // Defer only the requested planes, preserving the other attachment's load/store contract.
+            auto deferArrayClear = [&](VkRenderingAttachmentInfo& info, const VriAttachmentDesc* source,
+                                       VkImageAspectFlagBits aspect) {
+                if (!source || !source->view || info.loadOp != VK_ATTACHMENT_LOAD_OP_CLEAR)
+                    return;
+                const DescriptorVK* view = Desc(source->view);
+                if (c->device->Desc().adapter.vendorId != 0x5143 || view->texture->layerNum <= 1)
+                    return;
+                depthArrayClear.aspectMask |= aspect;
+                if (aspect == VK_IMAGE_ASPECT_DEPTH_BIT)
+                    depthArrayClear.clearValue.depthStencil.depth = info.clearValue.depthStencil.depth;
+                else
+                    depthArrayClear.clearValue.depthStencil.stencil = info.clearValue.depthStencil.stencil;
+                info.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+            };
+            deferArrayClear(depth, a->depth, VK_IMAGE_ASPECT_DEPTH_BIT);
