+        VriResult VRI_CALL CmdQueueFamilyTransfer(VriCommandBuffer* release, VriCommandBuffer* acquire,
+                                                 const VriBarrierGroupDesc* barriers)
+        {
+            if (!release || !acquire || !barriers || (!barriers->bufferNum && !barriers->textureNum) ||
+                (barriers->bufferNum && !barriers->buffers) || (barriers->textureNum && !barriers->textures))
+                return VriResult_InvalidArgument;
+            const auto* source = CB(release);
+            const auto* destination = CB(acquire);
+            if (source->device != destination->device || source->familyIndex == destination->familyIndex ||
+                !source->recording || !destination->recording || source->insideRendering ||
+                destination->insideRendering || source->colorInputPhase || destination->colorInputPhase)
+                return VriResult_InvalidArgument;
+#if defined(__APPLE__)
+            if (source->recordingResult != VriResult_Success)
+                return source->recordingResult;
+            if (destination->recordingResult != VriResult_Success)
+                return destination->recordingResult;
+#endif
+
+            for (uint32_t i = 0; i < barriers->bufferNum; ++i)
+            {
+                const auto& range = barriers->buffers[i];
+                const auto* b = range.buffer ? Buf(range.buffer) : nullptr;
+                if (!b || b->device != source->device || !b->buffer || b->bindingAllowed ||
+                    !b->familyTransferAllowed || range.offset >= b->size || range.size > b->size - range.offset ||
+                    (range.before.access && !range.before.stages) || (range.after.access && !range.after.stages))
+                    return VriResult_InvalidArgument;
+            }
+            for (uint32_t i = 0; i < barriers->textureNum; ++i)
+            {
+                const auto& range = barriers->textures[i];
+                const auto* t = range.texture ? Tex(range.texture) : nullptr;
+                if (!t || t->device != source->device || !t->image || t->bindingAllowed ||
+                    !t->familyTransferAllowed || range.baseMip >= t->mipNum || range.baseLayer >= t->layerNum ||
+                    range.mipNum > t->mipNum - range.baseMip || range.layerNum > t->layerNum - range.baseLayer ||
+                    range.before.layout <= VriLayout_Undefined || range.before.layout >= VriLayout_Present ||
+                    range.after.layout <= VriLayout_Undefined || range.after.layout >= VriLayout_Present ||
+                    (range.before.access && !range.before.stages) || (range.after.access && !range.after.stages))
+                    return VriResult_InvalidArgument;
+
+                VriImageAspectFlags available = VriImageAspect_Color;
+                switch (t->format)
+                {
+                    case VK_FORMAT_D16_UNORM:
+                    case VK_FORMAT_D32_SFLOAT: available = VriImageAspect_Depth; break;
+                    case VK_FORMAT_S8_UINT: available = VriImageAspect_Stencil; break;
+                    case VK_FORMAT_D24_UNORM_S8_UINT:
+                    case VK_FORMAT_D32_SFLOAT_S8_UINT:
+                        available = VriImageAspect_Depth | VriImageAspect_Stencil;
+                        break;
+                    default: break;
+                }
+                if (!range.aspect || (range.aspect & ~available))
+                    return VriResult_InvalidArgument;
+                if (range.aspect != available && !source->device->Desc().hasSeparateDepthStencilLayouts)
+                    return VriResult_Unsupported;
+            }
+            RecordBarriers(*CB(release), *barriers, source->familyIndex, destination->familyIndex);
+            RecordBarriers(*CB(acquire), *barriers, source->familyIndex, destination->familyIndex);
+            return VriResult_Success;
         }
 
