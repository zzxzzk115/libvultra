+
+    VriResult DeviceMTL::InitClearPipelines()
+    {
+        @autoreleasepool
+        {
+            NSError* error = nil;
+            MTLCompileOptions* options = [[MTLCompileOptions alloc] init];
+            options.languageVersion = MTLLanguageVersion3_0;
+            id<MTLLibrary> library = [m_device newLibraryWithSource:[NSString stringWithUTF8String:kClearTextureSource]
+                                                          options:options error:&error];
+            [options release];
+            if (!library)
+            {
+                ReportError(error ? [[error localizedDescription] UTF8String] : "Compile texture clear kernels failed");
+                return VriResult_Failure;
+            }
+            struct Shape { MTLTextureType type; const char* name; };
+            const Shape shapes[] = {
+                {MTLTextureType1D, "texture1d"},
+                {MTLTextureType1DArray, "texture1d_array"},
+                {MTLTextureType2D, "texture2d"},
+                {MTLTextureType2DArray, "texture2d_array"},
+                {MTLTextureType3D, "texture3d"},
+                {MTLTextureTypeCube, "texturecube"},
+                {MTLTextureTypeCubeArray, "texturecube_array"},
+            };
+            const char* types[] = {"float", "uint", "int"};
+            for (const auto& shape : shapes)
+            {
+                for (size_t type = 0; type < 3; ++type)
+                {
+                    char name[80];
+                    std::snprintf(name, sizeof(name), "clear_%s_%s", shape.name, types[type]);
+                    id<MTLFunction> function = [library newFunctionWithName:[NSString stringWithUTF8String:name]];
+                    if (!function)
+                    {
+                        ReportError("Missing texture clear kernel");
+                        [library release];
+                        return VriResult_Failure;
+                    }
+                    m_clearPipelines[shape.type][type] = [m_device newComputePipelineStateWithFunction:function error:&error];
+                    [function release];
+                    if (!m_clearPipelines[shape.type][type])
+                    {
+                        ReportError(error ? [[error localizedDescription] UTF8String] : "Create texture clear pipeline failed");
+                        [library release];
+                        return VriResult_Failure;
+                    }
+                }
+            }
+            [library release];
+        }
+        return VriResult_Success;
+    }
+
+    id<MTLComputePipelineState> DeviceMTL::ClearPipeline(MTLTextureType type, VriFormat format) const
+    {
+        if (type >= 8)
+        {
+            return nil;
+        }
+        size_t valueType = vri::FormatIsInteger(format) ? 1 : 0;
+        switch (format)
+        {
+            case VriFormat_R8_SINT: case VriFormat_RG8_SINT: case VriFormat_RGBA8_SINT:
+            case VriFormat_R16_SINT: case VriFormat_RG16_SINT: case VriFormat_RGBA16_SINT:
+            case VriFormat_R32_SINT: case VriFormat_RG32_SINT: case VriFormat_RGBA32_SINT:
+                valueType = 2;
+                break;
+            default:
+                break;
+        }
+        return m_clearPipelines[type][valueType];
     }
 
