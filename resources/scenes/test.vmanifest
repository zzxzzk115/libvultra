LightComponent/height = 1.000000
LightComponent/innerConeDegrees = 20.000000
LightComponent/outerConeDegrees = 30.000000
LightComponent/castsShadow = true
LightComponent/twoSided = false

[node id=6 name="Environment" parent=1]
