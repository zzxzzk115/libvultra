; TransformComponent/position = (0, 0, -1)
; TransformComponent/rotation = (0, 0, 0, 1)
; GaussianSplatComponent/gaussianSplat = @gaussian_splat.Lizard

[node id=4 name="DamagedHelmet" parent=1]
NameComponent/name = "DamagedHelmet"
TransformComponent/position = (0, 1, 0)
TransformComponent/rotation = (0, 0, 0, 1)
TransformComponent/scale = (0.3, 0.3, 0.3)
MeshComponent/mesh = @mesh.DamagedHelmet
ScriptComponent/scriptUri = @script.test_move
ScriptComponent/enabled = true

[node id=5 name="Sun" parent=1]
NameComponent/name = "Sun"
TransformComponent/position = (0, 4, 0)
TransformComponent/rotation = (-0.702802, 0.0788313, -0.0751287, 0.703001)
TransformComponent/scale = (1, 1, 1)
LightComponent/kind = 0
LightComponent/color = (1, 0.96, 0.9)
LightComponent/intensity = 2.000000
LightComponent/direction = (-0.35, -0.8, -0.25)
LightComponent/range = 100.000000
LightComponent/radius = 0.050000
LightComponent/width = 1.000000
LightComponent/height = 1.000000
LightComponent/innerConeDegrees = 20.000000
LightComponent/outerConeDegrees = 30.000000
LightComponent/castsShadow = true
LightComponent/twoSided = false
