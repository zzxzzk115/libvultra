[vmanifest]
version = 1
root = 1

[assets]
gaussian_splat.Lizard = "res://models/3dgs/hornedlizard.spz"
script.test_move = "res://scripts/test_move.lua"
texture.CitrusOrchardSky = "res://textures/environment_maps/citrus_orchard_puresky_1k.hdr"

[node id=1 name="Root" parent=0]
