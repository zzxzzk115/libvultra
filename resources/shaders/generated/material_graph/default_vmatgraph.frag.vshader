[vshader]
language = glsl
version = 460

[frag]
#extension GL_EXT_nonuniform_qualifier : require

#define VULTRA_DECLARE_BINDLESS_TEXTURES
#include "include/common/gpu_scene.glsl"

// Generated by Vultra material graph compiler. Include from a graph-aware surface shader.
#ifndef VULTRA_MATERIAL_GRAPH_SURFACE_DECLARED
#define VULTRA_MATERIAL_GRAPH_SURFACE_DECLARED
struct MaterialGraphSurface
{
    vec4 baseColor;
    vec3 normalWS;
    float metallic;
    float roughness;
    float ao;
    vec3 emissive;
    float alpha;
    float alphaCutoff;
    uint alphaMode;
    uint shadingModel;
};
#endif

const uint VULTRA_MATERIAL_GRAPH_ID_default_vmatgraph = 3089828321u;

MaterialGraphSurface eval_material_graph_default_vmatgraph(uint materialIndex, vec2 uv, vec3 positionWS, vec3 normalWS, vec3 viewDirWS, float timeSeconds)
{
    MaterialGraphSurface surface;
    surface.baseColor = mix(vec4(0.02, 0.16, 1.0, 1.0), vec4(1.0, 0.08, 0.0, 1.0), ((sin((timeSeconds * 1.2)) * 0.5) + 0.5));
    surface.normalWS = normalize(normalWS);
    surface.metallic = clamp(0.08, 0.0, 1.0);
    surface.roughness = clamp(0.42, 0.045, 1.0);
    surface.ao = clamp(1.0, 0.0, 1.0);
    surface.emissive = vec3(0.025, 0.012, 0.004);
    surface.alpha = clamp(1.0, 0.0, 1.0);
    surface.alphaCutoff = clamp(0.5, 0.0, 1.0);
    surface.alphaMode = 0u;
    surface.shadingModel = 0u;
    if (surface.shadingModel == 3u)
    {
        surface.metallic = 0.0;
    }
    if (surface.shadingModel == 4u)
    {
        surface.metallic = 0.0;
        surface.roughness = clamp(surface.roughness, 0.25, 1.0);
    }
    if (surface.shadingModel == 1u)
    {
        surface.metallic = 0.0;
        surface.roughness = 1.0;
        surface.emissive += surface.baseColor.rgb;
    }
    return surface;
}

layout(location = 0) out vec4 FragColor;
void main()
{
    MaterialGraphSurface surface = eval_material_graph_default_vmatgraph(0u, vec2(0.0), vec3(0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), 0.0);
    FragColor = surface.baseColor;
}
