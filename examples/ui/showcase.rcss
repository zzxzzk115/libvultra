body {
    width: 100%;
    height: 100%;
    margin: 0;
    font-family: LatoLatin;
}
#game-panel {
    position: absolute;
    top: 22px;
    left: 50%;
    margin-left: 8px;
    width: 296px;
}
.panel-description {
    display: block;
    margin: 3px 0 13px 0;
    color: #a6adb5;
    font-size: 12px;
}
.control-row span {
    display: inline-block;
    width: 245px;
    vertical-align: middle;
}
.control-row input {
    vertical-align: middle;
}
#save-image {
    display: block;
    width: 274px;
    margin: 13px 0 9px 0;
}
#preview-state {
    display: block;
    color: #a6adb5;
    font-size: 11px;
}
.section-title {
    display: block;
    margin-top: 17px;
    padding: 10px 0 7px 0;
    border-top: 1px #454b52;
    color: #d6d9dc;
    font-size: 13px;
}
#component-gallery {
    height: 370px;
    overflow-y: auto;
}
.component-label {
    display: block;
    margin: 12px 0 6px 0;
    color: #a6adb5;
    font-size: 11px;
}
.component-line {
    display: block;
    margin: 5px 0;
    font-size: 12px;
}
.component-line input {
    margin-right: 8px;
    vertical-align: middle;
}

.graphic-strip {
    height: 40px;
}
.graphic-strip > * {
    margin-right: 7px;
    vertical-align: middle;
}
.graphic-surface {
    display: inline-block;
    padding: 5px 9px;
    font-size: 11px;
}
