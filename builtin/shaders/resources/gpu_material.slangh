#pragma once

#include "resources/mesh_vertex.slangh"

struct MaterialData
{
    float4 baseColor;
    float4 surface;
    float4 emission;
    float4 coat;
    float4 specular;
    float4 flags;
    uint4  meshlets;
    uint4  instance; // Transform buffer index; the remaining lanes are reserved.
};

// D3D12 registers follow VRI's mapping of the material set (space 1): textures and samplers count from 0 in the
// layout's range order. Slang places the push constants at b2 in space 0, the first register after the frame
// set's two pinned constant buffers. An explicit register would also reserve a descriptor slot in the SPIR-V and
// WGSL layouts.
[[vk::push_constant]] ConstantBuffer<MaterialData> material;
[[vk::binding(0, 1)]] Texture2D<float4>            baseColorTexture : register(t0, space1);
[[vk::binding(1, 1)]] Texture2D<float4>            metallicRoughnessTexture : register(t1, space1);
[[vk::binding(2, 1)]] Texture2D<float4>            normalTexture : register(t2, space1);
[[vk::binding(3, 1)]] Texture2D<float4>            occlusionTexture : register(t3, space1);
[[vk::binding(4, 1)]] Texture2D<float4>            emissionTexture : register(t4, space1);
[[vk::binding(5, 1)]] Texture2D<float4>            specularTexture : register(t5, space1);
[[vk::binding(6, 1)]] Texture2D<float4>            specularColorTexture : register(t6, space1);
// One sampler per texture: WebGPU has no binding arrays.
[[vk::binding(7, 1)]] SamplerState                 baseColorSampler : register(s0, space1);
[[vk::binding(8, 1)]] SamplerState                 metallicRoughnessSampler : register(s1, space1);
[[vk::binding(9, 1)]] SamplerState                 normalSampler : register(s2, space1);
[[vk::binding(10, 1)]] SamplerState                occlusionSampler : register(s3, space1);
[[vk::binding(11, 1)]] SamplerState                emissionSampler : register(s4, space1);
[[vk::binding(12, 1)]] SamplerState                specularSampler : register(s5, space1);
[[vk::binding(13, 1)]] SamplerState                specularColorSampler : register(s6, space1);

// The base color of the bound material at `uv`; discards a fragment below its alpha cutoff.
float4 vultraBaseColor(float2 uv, float4 color)
{
    float4 result = baseColorTexture.Sample(baseColorSampler, uv) * material.baseColor * color;
    if (result.a < material.flags.x)
    {
        discard;
    }
    return result;
}

float3 surfaceNormal(SurfaceVertex input)
{
    float3 normal = normalize(input.normal);
    if (material.flags.w < 0.5)
    {
        return normal;
    }
    float3 tangent       = input.tangent.xyz - normal * dot(input.tangent.xyz, normal);
    float  tangentLength = dot(tangent, tangent);
    if (tangentLength < 1e-12)
    {
        return normal;
    }
    tangent *= rsqrt(tangentLength);
    float3 bitangent = input.tangent.w * cross(normal, tangent);
    float3 mapped    = normalTexture.Sample(normalSampler, input.uv).xyz * 2 - 1;
    if (material.flags.w > 1.5)
    {
        mapped.z = sqrt(saturate(1 - dot(mapped.xy, mapped.xy))); // BC5 stores only X and Y.
    }
    mapped.xy *= material.surface.w;
    return normalize(tangent * mapped.x + bitangent * mapped.y + normal * mapped.z);
}
