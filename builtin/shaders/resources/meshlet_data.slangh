#pragma once

#include "resources/mesh_vertex.slangh"

// Match Meshlet, SceneVertex and the limits in renderer/meshlets.hpp.
static const uint kMeshletVertices = 64;
static const uint kMeshletTriangles = 124;
static const uint kMeshletTaskSize = 32;

struct Meshlet
{
    uint4 geometry;
    float4 bounds;
};

[[vk::binding(0, 2)]] ByteAddressBuffer sceneVertices;
[[vk::binding(1, 2)]] StructuredBuffer<Meshlet> meshlets;
[[vk::binding(2, 2)]] StructuredBuffer<uint> meshletVertices;
[[vk::binding(3, 2)]] StructuredBuffer<uint> meshletTriangles;
