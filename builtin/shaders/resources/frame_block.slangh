#pragma once

struct FrameData
{
    float4x4 viewProjection;
    float4x4 inverseViewProjection;
    float4x4 view;
    float4   cameraPosition;
    float4   lightDirection;
    float4   lightColor;
    float4   ambientColor;
    float4   options;
    float4   cameraClip;
    float4   overrides; // Roughness, metalness, display transfer, meshlet display palette.
    float4   lightConfig; // Light count, index of the main directional light (-1 if absent).
};

// The path's camera.data of the view; keep in sync with CameraData in vultra/render/render_path.hpp.
struct CameraData
{
    float4x4 view;
    float4x4 projection;
    float4x4 viewProjection;
    float4x4 inverseView;
    float4x4 inverseProjection;
    float4x4 inverseViewProjection;
    float4x4 previousViewProjection;
    float4   position;
    float2   imageSize;
    float2   jitter;
    float    nearPlane;
    float    farPlane;
    float2   padding;
};

// Forward shading's frame. Include after `import vultra.material;`, which declares LightData and
// PrimitiveTransform. Only the bindings a shader of this block uses exist, so a stage stays within WebGPU's
// 16 sampled textures per shader stage together with the material block.
// The D3D12 registers follow VRI's mapping of forward shading's frame set (space 0): constant buffers are root
// descriptors at their binding, the other resources count from 0 per class in the layout's range order.
[[vk::binding(0, 0)]] ConstantBuffer<FrameData> frame : register(b0);
[[vk::binding(1, 0)]] ConstantBuffer<CameraData> camera : register(b1);
[[vk::binding(5, 0)]] Texture2D<float4>         radianceMap : register(t0);
[[vk::binding(6, 0)]] Texture2D<float4>         diffuseMap : register(t1);
[[vk::binding(7, 0)]] Texture2D<float4>         specularMap : register(t2);
[[vk::binding(8, 0)]] Texture2D<float4>         brdfLut : register(t3);
[[vk::binding(10, 0)]] SamplerState             environmentSampler : register(s0);
[[vk::binding(19, 0)]] StructuredBuffer<PrimitiveTransform> primitiveTransforms : register(t5);
[[vk::binding(20, 0)]] StructuredBuffer<LightData> sceneLights : register(t6);
