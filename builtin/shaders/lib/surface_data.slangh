#pragma once

#include "resources/frame_block.slangh"
#include "resources/primitive_transform.slangh"

#include "lib/surface_types.slangh"
#include "resources/gpu_material.slangh"

SurfaceVertex transformSurfaceVertex(MeshVertex input)
{
    SurfaceVertex result;
    PrimitiveTransform instance = primitiveTransforms[material.instance.x];
    result.worldPosition = mul(instance.model, float4(input.position, 1)).xyz;
    result.position      = mul(frame.viewProjection, float4(result.worldPosition, 1));
    result.normal        = mul(instance.normal, float4(input.normal, 0)).xyz;
    result.uv            = input.uv;
    result.color         = input.color;
    result.tangent       = float4(mul(instance.model, float4(input.tangent.xyz, 0)).xyz,
                                  input.tangent.w * instance.properties.x);
    return result;
}

SurfaceData sampleSurface(SurfaceVertex input, bool frontFace, float3 baseColor, float2 dx = 0, float2 dy = 0)
{
    SurfaceData result;
    float faceSign = frontFace ? 1 : -1;
    float2 mr = sampleSurfaceMap(metallicRoughnessTexture, 1, input.uv, dx, dy).bg;
    result.worldPosition = input.worldPosition;
    result.geometricNormal = normalize(input.normal) * faceSign;
    result.normal = surfaceNormal(input, dx, dy) * faceSign;
    result.baseColor = baseColor;
    result.baseWeight = material.flags.y;
    result.metallic = saturate(material.surface.x * mr.x);
    result.roughness = clamp(material.surface.y * mr.y, 0.03, 1);
    if (frame.overrides.x >= 0)
    {
        result.roughness = clamp(frame.overrides.x, 0.03, 1);
    }
    if (frame.overrides.y >= 0)
    {
        result.metallic = saturate(frame.overrides.y);
    }
#ifdef VULTRA_TRANSPARENCY_SKIP_ZERO_WEIGHT_MAPS
    // A zero factor makes the emission or occlusion map immaterial to shading.
    result.emission = 0;
    if (any(material.emission.rgb != 0))
    {
        result.emission = sampleSurfaceMap(emissionTexture, 4, input.uv, dx, dy).rgb * material.emission.rgb;
    }
    result.occlusion = 1;
    if (material.emission.w != 0)
    {
        result.occlusion = lerp(1, sampleSurfaceMap(occlusionTexture, 3, input.uv, dx, dy).r, material.emission.w);
    }
#else
    result.emission = sampleSurfaceMap(emissionTexture, 4, input.uv, dx, dy).rgb * material.emission.rgb;
    result.occlusion = lerp(1, sampleSurfaceMap(occlusionTexture, 3, input.uv, dx, dy).r, material.emission.w);
#endif
    result.specularColor = material.specular.rgb * sampleSurfaceMap(specularColorTexture, 6, input.uv, dx, dy).rgb;
    result.specularWeight = material.coat.w * sampleSurfaceMap(specularTexture, 5, input.uv, dx, dy).a;
    result.specularIor = material.surface.z;
    result.coatWeight = material.coat.x;
    result.coatRoughness = material.coat.y;
    result.coatIor = material.coat.z;
    result.baseDiffuseRoughness = material.specular.w;
    return result;
}
