#pragma once

#include "lib/surface_types.slangh"
#include "resources/gpu_material.slangh"
#include "resources/instance_data.slangh"

// A scene vertex placed in the world by its primitive's transform and projected by `viewProjection`.
SurfaceVertex vultraTransformVertex(MeshVertex input, InstanceData instance, float4x4 viewProjection)
{
    SurfaceVertex result;
    result.worldPosition = mul(instance.model, float4(input.position, 1)).xyz;
    result.position      = mul(viewProjection, float4(result.worldPosition, 1));
    result.normal        = mul(instance.normal, float4(input.normal, 0)).xyz;
    result.uv            = input.uv;
    result.color         = input.color;
    result.tangent       = float4(mul(instance.model, float4(input.tangent.xyz, 0)).xyz,
                                  input.tangent.w * instance.properties.x);
    return result;
}

// The surface the bound vultra.openpbr material gives an interpolated vertex; `baseColor` is
// vultraBaseColor().rgb.
VultraSurface vultraSampleSurface(VultraSurfaceInput surfaceInput, float3 baseColor)
{
    const OpenPbrParameters parameters = vultraOpenPbrParameters();
    const SurfaceVertex     input      = surfaceInput.vertex;
    VultraSurface result;
    float faceSign = surfaceInput.frontFace ? 1 : -1;
    float2 mr = vultraSampleMaterial(metallicRoughnessTexture, metallicRoughnessSampler, surfaceInput).bg;
    result.worldPosition = input.worldPosition;
    result.geometricNormal = normalize(input.normal) * faceSign;
    result.normal = surfaceNormal(surfaceInput) * faceSign;
    result.baseColor = baseColor;
    result.baseWeight = parameters.flags.y;
    result.metallic = saturate(parameters.surface.x * mr.x);
    result.roughness = clamp(parameters.surface.y * mr.y, 0.03, 1);
    result.emission =
        vultraSampleMaterial(emissionTexture, emissionSampler, surfaceInput).rgb * parameters.emission.rgb;
    result.occlusion =
        lerp(1, vultraSampleMaterial(occlusionTexture, occlusionSampler, surfaceInput).r, parameters.emission.w);
    result.specularColor =
        parameters.specular.rgb * vultraSampleMaterial(specularColorTexture, specularColorSampler, surfaceInput).rgb;
    result.specularWeight =
        parameters.coat.w * vultraSampleMaterial(specularTexture, specularSampler, surfaceInput).a;
    result.specularIor = parameters.surface.z;
    result.coatWeight = parameters.coat.x;
    result.coatRoughness = parameters.coat.y;
    result.coatIor = parameters.coat.z;
    result.baseDiffuseRoughness = parameters.specular.w;
    return result;
}
