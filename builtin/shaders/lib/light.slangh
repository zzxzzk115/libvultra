#pragma once

#include "lib/openpbr.slangh"
#include "resources/scene_lights.slangh"

// Reflected radiance of a directional light of `radiance` arriving from the unit direction `toLight`.
float3 vultraDirectionalLight(OpenPBR_PreparedBsdf bsdf, float3 toLight, float3 radiance)
{
    // Upstream eval returns BSDF times the incident cosine.
    OpenPBR_DiffuseSpecular response = openpbr_eval(bsdf, toLight);
    return openpbr_get_sum_of_diffuse_specular(response) * radiance;
}

// Where one light of the scene light buffer arrives from at `position`, and how much of its color and intensity
// reaches it. Point and spot intensity follows inverse-square falloff with a smooth finite-range cutoff.
struct VultraLightSample
{
    float3 toLight;     // Unit direction towards the light.
    float  attenuation; // Applies to the light's color times intensity.
};

VultraLightSample vultraSampleLight(LightData light, float3 position)
{
    VultraLightSample result;
    result.toLight     = light.directionKind.xyz;
    result.attenuation = 1;
    uint kind          = uint(light.directionKind.w);
    if (kind != 0)
    {
        float3 delta           = light.positionRange.xyz - position;
        float  distanceSquared = max(dot(delta, delta), 1e-6);
        float  distance        = sqrt(distanceSquared);
        result.toLight         = delta / distance;
        float cutoff           = saturate(1 - pow(distance / light.positionRange.w, 4));
        result.attenuation     = cutoff * cutoff / distanceSquared;
        if (kind == 2)
        {
            result.attenuation *=
                smoothstep(light.cones.y, light.cones.x, dot(result.toLight, light.directionKind.xyz));
        }
    }
    return result;
}

// Reflected radiance of one light of the scene light buffer at `position`.
float3 vultraSceneLight(OpenPBR_PreparedBsdf bsdf, LightData light, float3 position)
{
    const VultraLightSample arrival  = vultraSampleLight(light, position);
    OpenPBR_DiffuseSpecular response = openpbr_eval(bsdf, arrival.toLight);
    return openpbr_get_sum_of_diffuse_specular(response) * light.colorIntensity.rgb * light.colorIntensity.w *
           arrival.attenuation;
}
