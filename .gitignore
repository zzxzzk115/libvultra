# Vultra
.vultra/
*.vpk
# Generated builtin resources: shader/texture/i18n/rendergraph headers, compiled shader
# libraries (builtin/xmake.lua tasks), and the embedded resource pack (tools/builtinpack).
# All reproduced on configure. The hand-written embed sources in builtin/embed/ ARE tracked.
builtin/generated/
builtin/shader_lib/

# AI Agents
.claude/

# Native plugin build artifacts (emitted next to their plugin.lua manifest)
examples/plugins/**/*.dll
examples/plugins/**/*.so
examples/plugins/**/*.dylib
examples/plugins/**/*.pdb
examples/plugins/**/*.exp
examples/plugins/**/*.lib
# resources/plugins is project content. If a plugin is installed there, its native
# runtime files are intended to be versioned with the project.

# Project-local environment/config secrets.
.env
.env.*
**/.env
**/.env.*
!.env.example
